---
import ThemeToggle from "./ThemeToggle.astro"

const nav = [
  { label: "About", href: "/" },
  { label: "Work", href: "/work" },
  { label: "Notes", href: "/notes" },
]

const pathname = Astro.url.pathname
function isActive(href: string) {
  if (href === "/") return pathname === "/"
  return pathname.startsWith(href)
}
---

<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
    <!-- Site name -->
    <a href="/" class="font-semibold text-sm tracking-tight text-[var(--text)] hover:text-[var(--accent)] transition-colors">
      Aakriti Dhakal
    </a>

    <!-- Desktop nav -->
    <nav class="hidden sm:flex items-center gap-1" aria-label="Main navigation">
      {nav.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            "px-3 py-1.5 text-sm rounded-md transition-colors",
            isActive(href)
              ? "text-[var(--accent)] font-medium"
              : "text-[var(--text-secondary)] hover:text-[var(--text)]",
          ]}
          aria-current={isActive(href) ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Right controls -->
    <div class="flex items-center gap-1">
      <!-- Search trigger -->
      <button
        id="search-trigger"
        aria-label="Search (Cmd+K)"
        class="w-8 h-8 flex items-center justify-center rounded-md text-[var(--text-secondary)] hover:text-[var(--text)] hover:bg-[var(--bg-raised)] transition-colors"
      >
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <ThemeToggle />

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-trigger"
        aria-label="Open menu"
        aria-expanded="false"
        class="sm:hidden w-8 h-8 flex items-center justify-center rounded-md text-[var(--text-secondary)] hover:text-[var(--text)] hover:bg-[var(--bg-raised)] transition-colors"
      >
        <svg id="hamburger-icon" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>
