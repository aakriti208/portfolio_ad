---
interface Props {
  tags: string[]
  activeTag?: string
}

const { tags, activeTag } = Astro.props
---

<div class="flex flex-wrap gap-1.5 mb-6" role="list" aria-label="Filter by tag">
  <a
    href="?"
    class:list={[
      "font-mono text-xs px-2.5 py-1 rounded border transition-colors",
      !activeTag
        ? "bg-[var(--accent)] border-[var(--accent)] text-white"
        : "border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text)] hover:border-[var(--text-secondary)] bg-transparent",
    ]}
    role="listitem"
  >
    All
  </a>
  {tags.map((tag) => (
    <a
      href={`?tag=${encodeURIComponent(tag)}`}
      class:list={[
        "font-mono text-xs px-2.5 py-1 rounded border transition-colors",
        activeTag === tag
          ? "bg-[var(--accent)] border-[var(--accent)] text-white"
          : "border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text)] hover:border-[var(--text-secondary)] bg-transparent",
      ]}
      role="listitem"
    >
      {tag}
    </a>
  ))}
</div>
