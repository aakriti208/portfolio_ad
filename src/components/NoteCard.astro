---
import type { CollectionEntry } from "astro:content"
import { formatDate } from "@lib/utils"

interface Props {
  note: CollectionEntry<"notes">
}

const { note } = Astro.props
const { title, date, summary, tags } = note.data
---

<article class="py-5 border-b border-[var(--border)] last:border-0">
  <a href={`/notes/${note.slug}`} class="group block">
    <div class="flex items-baseline gap-3 mb-1">
      <time
        datetime={date.toISOString()}
        class="font-mono text-xs text-[var(--text-secondary)] shrink-0"
      >
        {formatDate(date)}
      </time>
    </div>
    <h2 class="text-base font-medium text-[var(--text)] group-hover:text-[var(--accent)] transition-colors mb-1">
      {title}
    </h2>
    <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-2">{summary}</p>
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="font-mono text-xs px-2 py-0.5 bg-[var(--bg-raised)] border border-[var(--border)] rounded text-[var(--text-secondary)]">
          {tag}
        </span>
      ))}
    </div>
  </a>
</article>
