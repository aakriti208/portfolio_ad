---
import BaseLayout from "@layouts/BaseLayout.astro"
import ToolStack from "@components/ToolStack.astro"
import { formatDateShort } from "@lib/utils"

const work = [
  {
    company: "Texas State University",
    role: "Graduate Research Assistant",
    start: new Date("2024-08-01"),
    end: null,
    location: "San Marcos, TX",
    bullets: [
      "Built a RAG-based AI Tutor integrating institutional course management APIs with ChromaDB, reducing instructor and TA workload by 50%",
      "Built ML training pipelines using PyTorch Lightning to process 60K+ images with automated ingestion, checkpointing, and real-time metric logging",
      "Optimized a GPT corpus generation pipeline at TACC using C++ and OpenMP, achieving an 11.37x peak speedup with 80% parallel efficiency",
      "Collaborated to integrate NLP and Deep Learning modules across 15 majors, training 5,000+ students in AI literacy",
    ],
  },
  {
    company: "THRC",
    role: "Graduate Assistant",
    start: new Date("2025-06-01"),
    end: new Date("2025-08-31"),
    location: "San Marcos, TX",
    bullets: [
      "Partnered with policymakers to deliver Tableau insights from complex healthcare data, driving a 15% increase in veteran healthcare access across 22 rural Texas counties",
      "Performed EDA on large-scale healthcare datasets (10M+ rows, 38 variables) to reveal mental health trends among Texas veterans",
    ],
  },
  {
    company: "Heubert Technologies",
    role: "Software Engineer",
    start: new Date("2021-05-01"),
    end: new Date("2023-12-01"),
    location: "New South Wales, Australia",
    bullets: [
      "Built scalable RESTful APIs for education consultants managing student applications across 600+ partner universities in 4 countries, growing MAU from 15,000 to 25,000",
      "Modernized front-end from legacy class components to React Hooks, eliminating frequent UI errors and improving page load speed by 500%",
      "Automated CI/CD pipelines with AWS CodePipeline and Bitbucket, saving ~$50k by catching issues early in automated test suites",
    ],
  },
  {
    company: "NEEF",
    role: "Associate Software Engineer",
    start: new Date("2019-02-01"),
    end: new Date("2021-04-01"),
    location: "Kathmandu, Nepal",
    bullets: [
      "Increased sales conversion by 50% building NEEF's e-commerce frontend with ReactJS and Material UI, integrating Esewa API for secure payments",
      "Built SEO-friendly sites with Contentful and Next.js, boosting organic traffic by 82% in the first six months",
    ],
  },
]
---

<BaseLayout title="Aakriti Dhakal" description="AI engineer, ML researcher, and software engineer based in Seattle.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 lg:py-16">

    <!-- Bio -->
    <section class="mb-14">
      <h1 class="text-2xl font-semibold text-[var(--text)] mb-4">Aakriti Dhakal</h1>
      <div class="space-y-3 text-[var(--text-secondary)] leading-relaxed">
        <p>
          I'm a software engineer and ML researcher focused on building reliable AI systems —
          retrieval-augmented generation, agent pipelines, and production ML infrastructure.
          Currently finishing my MS in Computer Science at Texas State University.
        </p>
        <p>
          My work sits at the intersection of applied ML and backend engineering. I care about
          systems that are grounded, auditable, and actually useful — not just technically
          impressive.
        </p>
        <p>
          Previously: software engineer at Heubert Technologies (visa processing SaaS) and NEEF.
          Based in Seattle.
        </p>
      </div>
      <div class="flex items-center gap-4 mt-6">
        <a href="https://github.com/aakriti208" target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">GitHub</a>
        <a href="https://www.linkedin.com/in/aakriti-dhakal/" target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">LinkedIn</a>
        <a href="mailto:aakritidh208@gmail.com" class="font-mono text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Email</a>
      </div>
    </section>

    <!-- Work timeline -->
    <section class="mb-14">
      <h2 class="text-sm font-semibold text-[var(--text)] mb-6 pb-2 border-b border-[var(--border)]">Experience</h2>
      <div class="space-y-8">
        {work.map((job) => (
          <div class="grid sm:grid-cols-[180px_1fr] gap-2 sm:gap-6">
            <div class="shrink-0">
              <p class="font-mono text-xs text-[var(--text-secondary)]">
                {formatDateShort(job.start)} — {job.end ? formatDateShort(job.end) : "Present"}
              </p>
              <p class="font-mono text-xs text-[var(--text-secondary)] mt-0.5">{job.location}</p>
            </div>
            <div>
              <p class="font-medium text-[var(--text)] text-sm">{job.role}</p>
              <p class="text-[var(--text-secondary)] text-sm mb-2">{job.company}</p>
              <ul class="space-y-1.5 text-sm text-[var(--text-secondary)]">
                {job.bullets.map((b) => (
                  <li class="flex gap-2">
                    <span class="text-[var(--border)] mt-1.5 shrink-0">—</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Tool stack -->
    <section class="mb-14">
      <h2 class="text-sm font-semibold text-[var(--text)] mb-6 pb-2 border-b border-[var(--border)]">Stack</h2>
      <ToolStack />
    </section>

    <!-- Contact -->
    <section>
      <h2 class="text-sm font-semibold text-[var(--text)] mb-4 pb-2 border-b border-[var(--border)]">Contact</h2>
      <p class="text-[var(--text-secondary)] text-sm mb-3">
        Open to research collaborations and engineering roles in applied AI and ML infrastructure.
      </p>
      <a href="mailto:aakritidh208@gmail.com" class="font-mono text-sm text-[var(--accent)] hover:underline">
        aakritidh208@gmail.com
      </a>
    </section>

  </div>
</BaseLayout>
