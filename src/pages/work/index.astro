---
import BaseLayout from "@layouts/BaseLayout.astro"
import ProjectCard from "@components/ProjectCard.astro"
import { getCollection } from "astro:content"

const allProjects = await getCollection("projects")

// Sort: In progress first, then Completed, then Paused; within each group by start_date desc
const order = { "In progress": 0, "Completed": 1, "Paused": 2 }
const projects = allProjects.sort((a, b) => {
  const statusDiff = order[a.data.status] - order[b.data.status]
  if (statusDiff !== 0) return statusDiff
  return b.data.start_date.getTime() - a.data.start_date.getTime()
})
---

<BaseLayout title="Work — Aakriti Dhakal" description="Projects and engineering work.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 lg:py-14">
    <header class="mb-8">
      <h1 class="text-2xl font-semibold text-[var(--text)] mb-2">Work</h1>
      <p class="text-[var(--text-secondary)]">Projects I've built or contributed to.</p>
    </header>

    <div>
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</BaseLayout>
