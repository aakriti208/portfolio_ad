---
import BaseLayout from "@layouts/BaseLayout.astro"
import NoteCard from "@components/NoteCard.astro"
import TagFilter from "@components/TagFilter.astro"
import { getCollection } from "astro:content"

const allNotes = await getCollection("notes", ({ data }) => !data.draft)
const sorted = allNotes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// Collect all unique tags
const allTags = [...new Set(sorted.flatMap((n) => n.data.tags))].sort()

// Filter by tag from URL
const activeTag = Astro.url.searchParams.get("tag") ?? undefined
const filtered = activeTag ? sorted.filter((n) => n.data.tags.includes(activeTag)) : sorted
---

<BaseLayout title="Notes — Aakriti Dhakal" description="Writing on AI, systems, and software engineering.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 lg:py-14">
    <header class="mb-8">
      <h1 class="text-2xl font-semibold text-[var(--text)] mb-2">Notes</h1>
      <p class="text-[var(--text-secondary)]">Writing on AI, ML systems, and software engineering.</p>
    </header>

    <TagFilter tags={allTags} activeTag={activeTag} />

    <div>
      {filtered.length > 0
        ? filtered.map((note) => <NoteCard note={note} />)
        : <p class="text-[var(--text-secondary)] text-sm py-8">No notes tagged "{activeTag}".</p>
      }
    </div>
  </div>
</BaseLayout>
