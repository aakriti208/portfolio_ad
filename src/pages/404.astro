---
import BaseLayout from "@layouts/BaseLayout.astro"
---

<BaseLayout title="404 — Aakriti Dhakal">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
    <p class="font-mono text-xs text-[var(--text-secondary)] mb-3">404</p>
    <h1 class="text-2xl font-semibold text-[var(--text)] mb-3">Page not found</h1>
    <p class="text-[var(--text-secondary)] mb-8">This page doesn't exist or was moved.</p>
    <a href="/" class="font-mono text-sm text-[var(--accent)] hover:underline">← Back home</a>
  </div>
</BaseLayout>
